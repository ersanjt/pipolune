Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8
AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg

RewriteEngine On
# One canonical host for SEO and cookies.
RewriteCond %{HTTP_HOST} ^www\.pipolune\.com$ [NC]
RewriteRule ^(.*)$ https://pipolune.com/$1 [R=301,L]
# "/" chooses the language per visitor (lang-redirect.php sends no-store so caches never share it).
RewriteRule ^$ /lang-redirect.php [L]

<FilesMatch "^lang-redirect\.php$">
  <IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex"
  </IfModule>
</FilesMatch>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  # /_astro/ files are content-hashed, so they can be cached for a long time.
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  # Images keep stable names; a short lifetime lets updates appear quickly.
  ExpiresByType image/webp "access plus 1 day"
  ExpiresByType image/png "access plus 1 day"
  ExpiresByType image/jpeg "access plus 1 day"
  ExpiresByType image/svg+xml "access plus 1 day"
  ExpiresByType image/x-icon "access plus 1 day"
</IfModule>
