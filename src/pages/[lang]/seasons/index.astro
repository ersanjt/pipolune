---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import PageBand from '../../../components/PageBand.astro';
import Icon from '../../../components/Icon.astro';
import { locales, ui, type Locale, type SeasonKey } from '../../../i18n/ui';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = ui[lang];
const seasons: SeasonKey[] = ['spring', 'summer', 'autumn', 'winter'];
const path = 'seasons/';
---

<BaseLayout lang={lang} title={`${t.seasonsPageTitle} — Pipolune`} description={t.seasonsPageLead} path={path}>
  <a class="skip-link" href="#main">{t.skipLink}</a>
  <SiteHeader lang={lang} path={path} />
  <main id="main" class="container">
    <PageBand title={t.seasonsPageTitle} subtitle={t.seasonsPageLead} />
    <ul class="season-index">
      {
        seasons.map((season) => (
          <li style={`--tint: var(--tint-${season});`}>
            <a href={`/${lang}/seasons/${season}/`}>
              <img src={`/images/home/season-${season}.webp`} alt="" width="210" height="166" />
              <div>
                <p>{t.seasonKicker[season]}</p>
                <h2>
                  {t.seasons[season]}
                  <Icon name="arrow" size={18} />
                </h2>
                <p>{t.seasonLead[season]}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
  <SiteFooter lang={lang} />
</BaseLayout>

<style>
  .season-index {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0 0 var(--space-7);
    list-style: none;
  }

  .season-index li {
    background: var(--tint);
    border-radius: var(--radius-sm);
  }

  .season-index a {
    display: grid;
    gap: var(--space-3);
    min-height: 100%;
    padding: var(--space-4);
    text-decoration: none;
  }

  .season-index img {
    width: min(180px, 46%);
    height: auto;
  }

  .season-index h2 {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 500;
  }

  .season-index p {
    max-width: 36ch;
    color: var(--color-text-muted);
  }

  @media (min-width: 800px) {
    .season-index {
      grid-template-columns: 1fr 1fr;
    }

    .season-index a {
      grid-template-columns: 148px minmax(0, 1fr);
      align-items: center;
      gap: var(--space-5);
      min-height: 180px;
    }
  }
</style>
