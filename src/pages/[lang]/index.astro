---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Icon from '../../components/Icon.astro';
import ProductCard from '../../components/ProductCard.astro';
import { locales, ui, type Locale, type SeasonKey } from '../../i18n/ui';
import { loadCatalog } from '../../lib/catalog';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = ui[lang];
const site = Astro.site!;

// Layout and imagery follow design/reference/00-selected-direction.png and 01-home-seasons.png.
const seasons: SeasonKey[] = ['spring', 'summer', 'autumn', 'winter'];
const products = (await loadCatalog()).slice(0, 3);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Pipolune',
    url: site.href,
    logo: new URL('/brand/icon-512.png', site).href,
    email: 'info@pipolune.com',
    areaServed: 'TR',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Pipolune',
    url: new URL(`/${lang}/`, site).href,
    inLanguage: lang,
  },
];
---

<BaseLayout lang={lang} title={t.metaTitle} description={t.metaDescription} jsonLd={jsonLd}>
  <a class="skip-link" href="#main">{t.skipLink}</a>
  <SiteHeader lang={lang} />

  <main id="main" class="container">
    <section class="hero">
      <picture class="hero__art">
        <source media="(max-width: 899px)" srcset="/images/home/hero-woodland-tall.webp" width="440" height="550" />
        <img src="/images/home/hero-woodland.webp" alt="" width="517" height="310" fetchpriority="high" />
      </picture>
      <div class="hero__text">
        <h1>{t.heroTitle}</h1>
        <div class="hero__divider" aria-hidden="true"><span>✦</span></div>
        <p>{t.heroLead}</p>
        <a class="button" href={`/${lang}/shop/`}>
          {t.heroCta}
          <Icon name="arrow" size={20} />
        </a>
      </div>
    </section>

    <section id="seasons" class="seasons" aria-label={t.seasonsTitle}>
      <ul>
        {
          seasons.map((s) => (
            <li class="season-card" style={`--tint: var(--tint-${s});`} data-season={s}>
              <a href={`/${lang}/shop/?season=${s}`}>
                <img src={`/images/home/season-${s}.webp`} alt="" width="105" height="83" loading="lazy" />
                <span class="season-card__label">
                  {t.seasons[s]}
                  <Icon name="arrow" size={16} />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="collection" class="collection" aria-labelledby="collection-title">
      <h2 id="collection-title" class="visually-hidden">{t.collectionTitle}</h2>
      <ul>
        {products.map((product) => <ProductCard product={product} lang={lang} />)}
      </ul>
      <p class="preview-note"><span aria-hidden="true">✦</span> {t.previewNote} <span aria-hidden="true">✦</span></p>
    </section>

    <section id="about" class="about" aria-labelledby="about-title">
      <h2 id="about-title">{t.aboutTitle}</h2>
      <p>{t.aboutBody}</p>
      <p data-sales-status data-open-text={t.statusOpenBody}>{t.statusBody}</p>
      <p>{t.contactBody} <a href="mailto:info@pipolune.com">info@pipolune.com</a></p>
    </section>
  </main>

  <SiteFooter lang={lang} />
</BaseLayout>

<script>
  import { getSession } from '../../lib/session';

  // Season (Europe/Istanbul calendar or pinned in Studio) and sales mode come from the API.
  getSession()
    .then((s) => {
      document.querySelector(`.season-card[data-season="${s.settings.season}"]`)?.classList.add('is-current');
      const status = document.querySelector<HTMLElement>('[data-sales-status]');
      if (status && s.settings.salesMode !== 'off' && status.dataset.openText) status.textContent = status.dataset.openText;
    })
    .catch(() => {});
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    display: grid;
    margin-top: var(--space-4);
  }

  .hero__art img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 50% 30%;
  }

  .hero__text {
    padding: var(--space-5) 0 var(--space-6);
  }

  .hero h1 {
    font-size: clamp(2.25rem, 9vw, 3rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.01em;
  }

  .hero__divider {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    max-width: 300px;
    margin: var(--space-4) 0;
    font-size: 0.875rem;
  }

  .hero__divider::before,
  .hero__divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--color-forest);
    opacity: 0.6;
  }

  .hero__text p {
    max-width: 34ch;
    font-size: 1.125rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 48px;
    margin-top: var(--space-5);
    padding: 0 var(--space-5);
    font-size: 1.0625rem;
    color: var(--color-milk);
    background: var(--color-forest);
    border-radius: var(--radius-sm);
    text-decoration: none;
  }

  .button:hover {
    background: #1b3119;
  }

  @media (min-width: 900px) {
    .hero {
      position: relative;
      min-height: clamp(420px, 38vw, 520px);
      margin-top: 0;
      overflow: hidden;
    }

    .hero__art {
      position: absolute;
      inset: 0 0 0 auto;
      width: 68%;
    }

    .hero__art img {
      height: 100%;
      aspect-ratio: auto;
      object-position: 50% 50%;
      mask-image: linear-gradient(to right, transparent 0%, #000 22%);
    }

    .hero__text {
      position: relative;
      align-self: center;
      max-width: 520px;
      padding: var(--space-7) 0;
    }

    .hero h1 {
      font-size: clamp(3rem, 4.6vw, 4.25rem);
      max-width: 14ch;
    }
  }

  /* ---------- Season cards ---------- */
  .seasons ul {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .season-card {
    background: var(--tint);
    border-radius: var(--radius-sm);
    overflow: hidden;
    outline: 1px solid transparent;
    transition: outline-color 0.2s ease;
  }

  .season-card.is-current {
    outline-color: rgb(32 61 43 / 0.35);
  }

  .season-card a {
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
    padding-bottom: var(--space-3);
    text-align: center;
    text-decoration: none;
  }

  .season-card img {
    height: 64px;
    width: auto;
  }

  .season-card__label {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    font-size: 0.9375rem;
  }

  @media (max-width: 639px) {
    .seasons ul {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-3);
    }

    .season-card a {
      min-height: 96px;
    }

    .season-card__label {
      font-size: 1rem;
    }
  }

  @media (min-width: 900px) {
    .seasons ul {
      gap: var(--space-4);
    }

    .season-card a {
      flex-direction: row;
      min-height: 96px;
      padding-bottom: 0;
      gap: var(--space-5);
      text-align: left;
    }

    .season-card__label {
      flex-direction: row;
      gap: var(--space-3);
      font-size: 1.125rem;
    }

    .season-card img {
      height: 96px;
    }
  }

  /* ---------- Product cards ---------- */
  .collection {
    margin-top: var(--space-5);
  }

  .collection ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .preview-note {
    margin-top: var(--space-5);
    font-size: 0.875rem;
    text-align: center;
    color: var(--color-text-muted);
  }

  @media (min-width: 900px) {
    .collection ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-4);
    }
  }

  /* ---------- About ---------- */
  .about {
    display: grid;
    gap: var(--space-3);
    max-width: 62ch;
    margin: var(--space-8) auto 0;
    text-align: center;
  }

  .about h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.25rem);
    font-weight: 500;
  }

  .about a {
    font-weight: 500;
    text-underline-offset: 4px;
  }
</style>
