---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { locales, ui, type Locale, type SeasonKey } from '../../i18n/ui';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = ui[lang];

const seasons: { key: SeasonKey; accent: string; tint: string }[] = [
  { key: 'spring', accent: 'var(--color-blush)', tint: 'rgb(232 183 190 / 0.22)' },
  { key: 'summer', accent: 'var(--color-butter)', tint: 'rgb(238 215 139 / 0.22)' },
  { key: 'autumn', accent: 'var(--color-copper)', tint: 'rgb(185 105 63 / 0.14)' },
  { key: 'winter', accent: 'var(--color-mist)', tint: 'rgb(184 206 218 / 0.28)' },
];
---

<BaseLayout lang={lang} title={t.metaTitle} description={t.metaDescription}>
  <a class="skip-link" href="#main">{t.skipLink}</a>
  <SiteHeader lang={lang} />

  <main id="main">
    <section class="hero">
      <div class="container hero__inner">
        <div class="hero__text">
          <h1>{t.heroTitle}</h1>
          <span class="hero__star" aria-hidden="true">✦</span>
          <p class="hero__lead">{t.heroLead}</p>
        </div>
        <img
          class="hero__art"
          src="/brand/woodland-four-seasons-banner.webp"
          alt=""
          width="696"
          height="255"
          fetchpriority="high"
        />
      </div>
    </section>

    <section class="container status" aria-labelledby="status-title">
      <h2 id="status-title">{t.statusTitle}</h2>
      <p>{t.statusBody}</p>
    </section>

    <section class="container seasons" aria-labelledby="seasons-title">
      <header class="section-head">
        <h2 id="seasons-title">{t.seasonsTitle}</h2>
        <p>{t.seasonsLead}</p>
      </header>
      <ul class="seasons__grid">
        {
          seasons.map(({ key, accent, tint }) => (
            <li class="season" data-season={key} style={`--season-accent: ${accent}; --season-tint: ${tint};`}>
              <h3>{t.seasons[key].name}</h3>
              <p class="season__months">{t.seasons[key].months}</p>
              <p class="season__note">{t.seasons[key].note}</p>
              <span class="season__badge" hidden>
                {t.currentSeason}
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="container contact" aria-labelledby="contact-title">
      <h2 id="contact-title">{t.contactTitle}</h2>
      <p>
        {t.contactBody} <a href="mailto:info@pipolune.com">info@pipolune.com</a>
      </p>
    </section>
  </main>

  <SiteFooter lang={lang} />
</BaseLayout>

<script>
  // Seasons follow the Europe/Istanbul calendar, not the visitor's local time zone.
  const month = Number(
    new Intl.DateTimeFormat('en', { timeZone: 'Europe/Istanbul', month: 'numeric' }).format(new Date()),
  );
  const current =
    month >= 3 && month <= 5 ? 'spring' : month >= 6 && month <= 8 ? 'summer' : month >= 9 && month <= 11 ? 'autumn' : 'winter';
  const card = document.querySelector<HTMLElement>(`.season[data-season="${current}"]`);
  if (card) {
    card.classList.add('is-current');
    card.querySelector<HTMLElement>('.season__badge')?.removeAttribute('hidden');
  }
</script>

<style>
  .hero {
    padding-block: var(--space-7) var(--space-6);
  }

  .hero__inner {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  .hero h1 {
    font-size: clamp(2.25rem, 6vw, 4.25rem);
  }

  .hero__art {
    order: -1;
  }

  .hero__star {
    display: block;
    margin-block: var(--space-4);
    font-size: 0.875rem;
  }

  .hero__lead {
    max-width: 38ch;
    font-size: 1.0625rem;
    color: var(--color-text-muted);
  }

  .hero__art {
    width: 100%;
    mask-image: radial-gradient(ellipse 75% 85% at 55% 50%, #000 60%, transparent 100%);
  }

  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: 5fr 7fr;
    }

    .hero h1 {
      max-width: 12ch;
    }

    .hero__art {
      order: 0;
    }
  }

  .status {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-6);
    padding-block: var(--space-6);
    border-block: 1px solid var(--color-line);
  }

  .status h2,
  .contact h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.25rem);
  }

  .status p {
    max-width: 62ch;
  }

  .section-head {
    display: grid;
    gap: var(--space-2);
    margin-block: var(--space-8) var(--space-5);
  }

  .section-head h2 {
    font-size: clamp(2rem, 4vw, 2.75rem);
  }

  .section-head p {
    color: var(--color-text-muted);
  }

  .seasons__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 900px) {
    .seasons__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-4);
    }
  }

  .season {
    position: relative;
    display: grid;
    gap: var(--space-1);
    padding: var(--space-5) var(--space-4);
    background: var(--season-tint);
    border: 1px solid var(--color-line);
    border-top: 3px solid var(--season-accent);
    border-radius: var(--radius-md);
  }

  .season h3 {
    font-size: 1.75rem;
  }

  .season__months {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .season__note {
    margin-top: var(--space-2);
  }

  .season.is-current {
    border-color: var(--color-forest);
    border-top-color: var(--season-accent);
  }

  .season__badge {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    padding: 2px var(--space-2);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--color-milk);
    background: var(--color-forest);
    border-radius: 999px;
  }

  .contact {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .contact a {
    font-weight: 600;
    text-underline-offset: 4px;
  }
</style>
