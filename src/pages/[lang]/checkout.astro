---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import PageBand from '../../components/PageBand.astro';
import Checkout from '../../islands/Checkout';
import { locales, ui, type Locale } from '../../i18n/ui';
import { shop } from '../../i18n/shop';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const s = shop[lang];
---

<BaseLayout lang={lang} title={`${s.checkoutTitle} — Pipolune`} description={s.checkoutTitle} path="checkout/" noindex>
  <a class="skip-link" href="#main">{ui[lang].skipLink}</a>
  <SiteHeader lang={lang} path="checkout/" />
  <main id="main" class="container">
    <PageBand title={s.checkoutTitle}>
      <ol class="steps">
        <li data-step="1" data-state="current">{s.stepAddress}</li>
        <li data-step="2">{s.stepDelivery}</li>
        <li data-step="3">{s.stepReview}</li>
      </ol>
    </PageBand>
    <Checkout client:only="preact" lang={lang} />
  </main>
  <SiteFooter lang={lang} />
</BaseLayout>
