---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import PageBand from '../../../components/PageBand.astro';
import CatalogView from '../../../components/CatalogView.astro';
import { locales, ui, type Locale } from '../../../i18n/ui';
import { shop } from '../../../i18n/shop';
import { loadCatalog } from '../../../lib/catalog';
import { breadcrumb } from '../../../lib/store-schema';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = ui[lang];
const s = shop[lang];
const products = await loadCatalog();
const site = Astro.site!;
const jsonLd = [
  breadcrumb(site.origin, lang, [
    { name: 'Pipolune', path: '' },
    { name: s.shopTitle, path: 'shop/' },
  ]),
];
---

<BaseLayout lang={lang} title={`${s.shopTitle} — Pipolune`} description={s.shopMeta} path="shop/" jsonLd={jsonLd}>
  <a class="skip-link" href="#main">{t.skipLink}</a>
  <SiteHeader lang={lang} path="shop/" />
  <main id="main" class="container">
    <PageBand title={s.shopTitle} subtitle={s.shopLead} />
    <CatalogView products={products} lang={lang} />
    <p class="preview-note"><span aria-hidden="true">✦</span> {t.previewNote} <span aria-hidden="true">✦</span></p>
  </main>
  <SiteFooter lang={lang} />
</BaseLayout>

<style>
  .preview-note {
    margin-top: var(--space-6);
    font-size: 0.875rem;
    text-align: center;
    color: var(--color-text-muted);
  }
</style>
