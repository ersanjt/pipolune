---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import PageBand from '../../components/PageBand.astro';
import { locales, ui, type Locale } from '../../i18n/ui';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = ui[lang];
const path = 'contact/';
---

<BaseLayout lang={lang} title={`${t.contactTitle} — Pipolune`} description={t.contactLead} path={path}>
  <a class="skip-link" href="#main">{t.skipLink}</a>
  <SiteHeader lang={lang} path={path} />
  <main id="main" class="container">
    <PageBand title={t.contactTitle} subtitle={t.contactLead} />
    <div class="prose">
      <p><a href="mailto:info@pipolune.com">info@pipolune.com</a></p>
      <p>{t.contactBody}</p>
    </div>
  </main>
  <SiteFooter lang={lang} />
</BaseLayout>

<style>
  .prose {
    display: grid;
    gap: var(--space-4);
    max-width: 72ch;
    padding-bottom: var(--space-8);
  }

  .prose a {
    font-weight: 500;
    text-underline-offset: 4px;
  }
</style>
