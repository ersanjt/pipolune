---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import PageBand from '../../components/PageBand.astro';
import Bag from '../../islands/Bag';
import { locales, ui, type Locale } from '../../i18n/ui';
import { shop } from '../../i18n/shop';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const s = shop[lang];
---

<BaseLayout lang={lang} title={`${s.bagTitle} — Pipolune`} description={s.bagTitle} path="bag/" noindex>
  <a class="skip-link" href="#main">{ui[lang].skipLink}</a>
  <SiteHeader lang={lang} path="bag/" />
  <main id="main" class="container">
    <PageBand title={s.bagTitle}>
      <p class="muted" data-bag-count></p>
    </PageBand>
    <Bag client:only="preact" lang={lang} />
  </main>
  <SiteFooter lang={lang} />
</BaseLayout>
