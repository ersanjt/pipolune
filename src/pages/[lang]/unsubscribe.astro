---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import PageBand from '../../components/PageBand.astro';
import Unsubscribe from '../../islands/Unsubscribe';
import { locales, ui, type Locale } from '../../i18n/ui';
import { shop } from '../../i18n/shop';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const s = shop[lang];
---

<BaseLayout lang={lang} title={`${s.unsubTitle} — Pipolune`} description={s.unsubLead} path="unsubscribe/" noindex>
  <a class="skip-link" href="#main">{ui[lang].skipLink}</a>
  <SiteHeader lang={lang} path="unsubscribe/" />
  <main id="main" class="container">
    <PageBand title={s.unsubTitle} subtitle={s.unsubLead} />
    <Unsubscribe client:only="preact" lang={lang} />
  </main>
  <SiteFooter lang={lang} />
</BaseLayout>
