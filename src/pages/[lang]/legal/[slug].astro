---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import SellerCard from '../../../components/SellerCard.astro';
import { isLegalSlug, legal, legalSlugs, LEGAL_VERSION, type LegalSlug, type Locale } from '../../../i18n/legal';
import { locales, ui } from '../../../i18n/ui';

export function getStaticPaths() {
  return locales.flatMap((lang) => legalSlugs.map((slug) => ({ params: { lang, slug } })));
}

const lang = Astro.params.lang as Locale;
const slug = Astro.params.slug;
if (!isLegalSlug(slug)) {
  throw new Error('Unknown legal page');
}
const page = slug as LegalSlug;
const copy = legal[lang];
const doc = copy.documents[page];
const path = `legal/${page}/`;
---

<BaseLayout lang={lang} title={`${doc.title} — Pipolune`} description={doc.summary} path={path}>
  <a class="skip-link" href="#main">{ui[lang].skipLink}</a>
  <SiteHeader lang={lang} path={path} />
  <main id="main" class="container legal">
    <p class="legal__back"><a href={`/${lang}/legal/`}>{copy.hubTitle}</a></p>
    <h1>{doc.title}</h1>
    <p class="legal__meta">{copy.updated} · {copy.versionLabel} {LEGAL_VERSION}</p>
    <p class="legal__lead">{doc.summary}</p>
    <SellerCard lang={lang} />
    {
      doc.sections.map((section) => (
        <section class="legal__section">
          <h2>{section.heading}</h2>
          {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </section>
      ))
    }
    <p class="legal__notice">{copy.notice}</p>
    <nav class="legal__more" aria-label={copy.hubTitle}>
      <ul>
        {
          legalSlugs
            .filter((item) => item !== page)
            .map((item) => (
              <li>
                <a href={`/${lang}/legal/${item}/`}>{copy.documents[item].title}</a>
              </li>
            ))
        }
      </ul>
    </nav>
  </main>
  <SiteFooter lang={lang} />
</BaseLayout>
