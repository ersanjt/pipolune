---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import SellerCard from '../../../components/SellerCard.astro';
import { legal, legalSlugs, LEGAL_VERSION, type Locale } from '../../../i18n/legal';
import { locales, ui } from '../../../i18n/ui';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const copy = legal[lang];
const path = 'legal/';
---

<BaseLayout lang={lang} title={`${copy.hubTitle} — Pipolune`} description={copy.hubLead} path={path}>
  <a class="skip-link" href="#main">{ui[lang].skipLink}</a>
  <SiteHeader lang={lang} path={path} />
  <main id="main" class="container legal">
    <h1>{copy.hubTitle}</h1>
    <p class="legal__meta">{copy.updated} · {copy.versionLabel} {LEGAL_VERSION}</p>
    <p class="legal__lead">{copy.hubLead}</p>
    <SellerCard lang={lang} />
    <ul class="legal-index">
      {
        legalSlugs.map((slug) => {
          const doc = copy.documents[slug];
          return (
            <li>
              <a href={`/${lang}/legal/${slug}/`}>
                <strong>{doc.title}</strong>
                <span>{doc.summary}</span>
              </a>
            </li>
          );
        })
      }
    </ul>
    <p class="legal__notice">{copy.notice}</p>
  </main>
  <SiteFooter lang={lang} />
</BaseLayout>
