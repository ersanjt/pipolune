---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import PageBand from '../../components/PageBand.astro';
import OrderView from '../../islands/OrderView';
import { locales, ui, type Locale } from '../../i18n/ui';
import { shop } from '../../i18n/shop';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const s = shop[lang];
---

<BaseLayout lang={lang} title={`${s.orderDetails} — Pipolune`} description={s.orderDetails} path="order/" noindex>
  <a class="skip-link" href="#main">{ui[lang].skipLink}</a>
  <SiteHeader lang={lang} path="order/" />
  <main id="main" class="container">
    <PageBand title={s.thankYou} subtitle={s.requestReceived} />
    <OrderView client:only="preact" lang={lang} />
  </main>
  <SiteFooter lang={lang} />
</BaseLayout>

<script>
  // The same page serves later visits from email links; only a fresh checkout says "Thank you".
  if (new URLSearchParams(location.search).get('new') !== '1') {
    const title = document.querySelector('[data-band-title]');
    const sub = document.querySelector('.band__sub');
    if (title) title.textContent = document.title.split(' — ')[0];
    sub?.remove();
  }
</script>
