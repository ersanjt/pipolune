---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import PageBand from '../../components/PageBand.astro';
import { locales, ui, type Locale } from '../../i18n/ui';
import { store, storeLines, storeMapsUrl } from '../../lib/store';
import { breadcrumb, storeNode } from '../../lib/store-schema';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = ui[lang];
const path = 'about/';
const site = Astro.site!;
const jsonLd = [
  storeNode(site.origin, t.aboutBody),
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: t.aboutTitle,
    url: new URL(`/${lang}/${path}`, site).href,
    description: t.aboutBody,
    inLanguage: lang,
    mainEntity: { '@id': `${site.origin}/#shop` },
  },
  breadcrumb(site.origin, lang, [
    { name: 'Pipolune', path: '' },
    { name: t.aboutTitle, path },
  ]),
];
---

<BaseLayout lang={lang} title={`${t.aboutTitle} — Pipolune`} description={t.aboutBody} path={path} jsonLd={jsonLd} local>
  <a class="skip-link" href="#main">{t.skipLink}</a>
  <SiteHeader lang={lang} path={path} />
  <main id="main" class="container">
    <PageBand title={t.aboutTitle} subtitle={t.heroLead} />
    <div class="prose">
      <p>{t.aboutBody}</p>
      <p>{t.aboutMore}</p>
      <address class="visit">
        <span data-store-field="address" data-store-format="lines">{storeLines.join('\n')}</span>
        <a data-store-field="phone" href={`tel:${store.phoneTel}`}>{store.phone}</a>
        <a data-store-field="maps" href={storeMapsUrl} rel="noopener noreferrer">{t.directions}</a>
      </address>
      <p data-sales-status data-open-text={t.statusOpenBody}>{t.statusBody}</p>
      <p>
        <a href={`/${lang}/contact/`}>{t.contactTitle}</a>
      </p>
      <p><a href={`/${lang}/seasons/`}>{t.seasonsPageTitle}</a></p>
    </div>
  </main>
  <SiteFooter lang={lang} />
</BaseLayout>

<script>
  import { getSession } from '../../lib/session';

  getSession()
    .then((s) => {
      const status = document.querySelector<HTMLElement>('[data-sales-status]');
      if (status && s.settings.salesMode !== 'off' && status.dataset.openText) status.textContent = status.dataset.openText;
    })
    .catch(() => {});
</script>

<style>
  .prose {
    display: grid;
    gap: var(--space-4);
    max-width: 72ch;
    padding-bottom: var(--space-8);
  }

  .prose a {
    font-weight: 500;
    text-underline-offset: 4px;
  }

  .visit {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    font-style: normal;
    line-height: 1.5;
    white-space: pre-line;
  }
</style>
