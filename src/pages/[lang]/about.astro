---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import PageBand from '../../components/PageBand.astro';
import { locales, ui, type Locale } from '../../i18n/ui';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = ui[lang];
const path = 'about/';
---

<BaseLayout lang={lang} title={`${t.aboutTitle} — Pipolune`} description={t.aboutBody} path={path}>
  <a class="skip-link" href="#main">{t.skipLink}</a>
  <SiteHeader lang={lang} path={path} />
  <main id="main" class="container">
    <PageBand title={t.aboutTitle} subtitle={t.heroLead} />
    <div class="prose">
      <p>{t.aboutBody}</p>
      <p>{t.aboutMore}</p>
      <p data-sales-status data-open-text={t.statusOpenBody}>{t.statusBody}</p>
      <p>
        {t.contactBody} <a href={`/${lang}/contact/`}>{t.contactTitle}</a>
      </p>
      <p><a href={`/${lang}/seasons/`}>{t.seasonsPageTitle}</a></p>
    </div>
  </main>
  <SiteFooter lang={lang} />
</BaseLayout>

<script>
  import { getSession } from '../../lib/session';

  getSession()
    .then((s) => {
      const status = document.querySelector<HTMLElement>('[data-sales-status]');
      if (status && s.settings.salesMode !== 'off' && status.dataset.openText) status.textContent = status.dataset.openText;
    })
    .catch(() => {});
</script>

<style>
  .prose {
    display: grid;
    gap: var(--space-4);
    max-width: 72ch;
    padding-bottom: var(--space-8);
  }

  .prose a {
    font-weight: 500;
    text-underline-offset: 4px;
  }
</style>
