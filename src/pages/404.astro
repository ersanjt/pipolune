---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { defaultLocale, locales, ui } from '../i18n/ui';

const t = ui[defaultLocale];
---

<BaseLayout lang={defaultLocale} title={`${t.notFoundTitle} — Pipolune`} description={t.notFoundBody} noindex>
  <SiteHeader lang={defaultLocale} />
  <main class="container not-found">
    {
      locales.map((l) => (
        <section lang={l}>
          <h1>{ui[l].notFoundTitle}</h1>
          <p>{ui[l].notFoundBody}</p>
          <a href={`/${l}/`}>{ui[l].notFoundAction}</a>
        </section>
      ))
    }
  </main>
  <SiteFooter lang={defaultLocale} />
</BaseLayout>

<style>
  .not-found {
    display: grid;
    gap: var(--space-7);
    padding-block: var(--space-8);
  }

  .not-found section {
    display: grid;
    gap: var(--space-2);
  }

  .not-found h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
  }
</style>
