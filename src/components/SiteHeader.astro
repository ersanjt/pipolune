---
import Icon from './Icon.astro';
import CurrencySwitch from './CurrencySwitch.astro';
import { ui, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
  path?: string;
}

const { lang, path = '' } = Astro.props;
const t = ui[lang];
const home = `/${lang}/`;
/** Same order and labels as the chosen switcher: English, then Russian, then Turkish. */
const languages: { code: Locale; label: string }[] = [
  { code: 'en', label: 'English' },
  { code: 'ru', label: 'Russian' },
  { code: 'tr', label: 'Turkish' },
];
const navItems = [
  { href: `${home}shop/`, label: t.nav.shop },
  { href: `${home}#seasons`, label: t.nav.seasons },
  { href: `${home}#about`, label: t.nav.about },
];
const currencyLabel = { en: 'Currency', tr: 'Para birimi', ru: 'Валюта' }[lang];
---

<header class="site-header" data-menu-open="false">
  <button class="site-header__backdrop" type="button" tabindex="-1" hidden>
    <span class="visually-hidden">{t.closeMenu}</span>
  </button>
  <div class="container site-header__inner">
    <button class="icon-btn site-header__menu-btn" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="icon-open"><Icon name="menu" /></span>
      <span class="icon-close"><Icon name="close" /></span>
      <span class="visually-hidden">{t.menu}</span>
    </button>

    <a class="site-header__logo" href={home}>
      <img src="/brand/wordmark.svg" alt="Pipolune" width="723" height="204" />
    </a>

    <nav id="site-nav" class="site-nav" aria-label={t.menu}>
      <ul>
        {navItems.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li class="site-nav__mobile-only"><a href={`${home}account/`}>{t.account}</a></li>
      </ul>
    </nav>

    <div class="site-header__prefs">
      <div class="site-header__pref">
        <p class="site-header__pref-label" id="lang-label">{t.languageLabel}</p>
        <div class="lang-switch" data-open="false">
          <button
            class="lang-switch__toggle"
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="lang-menu"
          >
            <Icon name="language" size={22} />
            <span class="lang-switch__chevron" aria-hidden="true"><Icon name="chevron" size={14} /></span>
            <span class="visually-hidden">{t.languageLabel}</span>
          </button>
          <nav id="lang-menu" class="lang-switch__menu" aria-labelledby="lang-label">
            {
              languages.map((item) => (
                <a
                  href={`/${item.code}/${path}`}
                  hreflang={item.code}
                  lang={item.code}
                  data-lang={item.code}
                  aria-current={item.code === lang ? 'page' : undefined}
                >
                  {item.label}
                </a>
              ))
            }
          </nav>
        </div>
      </div>
      <div class="site-header__pref">
        <p class="site-header__pref-label">{currencyLabel}</p>
        <CurrencySwitch lang={lang} />
      </div>
    </div>

    <div class="site-header__tools">
      <a class="icon-btn" href={`${home}shop/`} title={t.search}>
        <Icon name="search" />
        <span class="visually-hidden">{t.search}</span>
      </a>
      <a class="icon-btn hide-mobile" href={`${home}account/`} title={t.account}>
        <Icon name="account" />
        <span class="visually-hidden">{t.account}</span>
      </a>
      <a class="icon-btn bag-link" href={`${home}bag/`} title={t.bag}>
        <Icon name="bag" />
        <span class="visually-hidden">{t.bag}</span>
        <span class="bag-link__count" data-cart-count hidden></span>
      </a>
    </div>
  </div>
</header>

<script>
  import { getSession, onSession, rememberLanguage, type Session } from '../lib/session';

  const header = document.querySelector<HTMLElement>('.site-header');
  const button = header?.querySelector<HTMLButtonElement>('.site-header__menu-btn');
  const backdrop = header?.querySelector<HTMLButtonElement>('.site-header__backdrop');
  const desktop = window.matchMedia('(min-width: 900px)');
  const setOpen = (open: boolean) => {
    const next = open && !desktop.matches;
    header?.setAttribute('data-menu-open', String(next));
    button?.setAttribute('aria-expanded', String(next));
    if (backdrop) backdrop.hidden = !next;
    document.documentElement.classList.toggle('nav-open', next);
  };
  const langSwitch = header?.querySelector<HTMLElement>('.lang-switch');
  const langButton = langSwitch?.querySelector<HTMLButtonElement>('.lang-switch__toggle');
  const langLinks = [...(langSwitch?.querySelectorAll<HTMLAnchorElement>('a[data-lang]') ?? [])];
  const setLangOpen = (open: boolean) => {
    langSwitch?.setAttribute('data-open', String(open));
    langButton?.setAttribute('aria-expanded', String(open));
  };

  button?.addEventListener('click', () => {
    const open = header?.dataset.menuOpen !== 'true';
    setOpen(open);
    if (open) setLangOpen(false);
  });
  backdrop?.addEventListener('click', () => setOpen(false));
  header?.querySelectorAll('.site-nav a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  desktop.addEventListener('change', () => {
    if (desktop.matches) setOpen(false);
  });

  langButton?.addEventListener('click', () => {
    const open = langButton.getAttribute('aria-expanded') !== 'true';
    setLangOpen(open);
    if (open) setOpen(false);
  });
  langButton?.addEventListener('keydown', (e) => {
    if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
    e.preventDefault();
    setLangOpen(true);
    setOpen(false);
    (e.key === 'ArrowUp' ? langLinks.at(-1) : langLinks[0])?.focus();
  });
  langSwitch?.addEventListener('keydown', (e) => {
    const current = langLinks.indexOf(document.activeElement as HTMLAnchorElement);
    if (current < 0 || (e.key !== 'ArrowDown' && e.key !== 'ArrowUp')) return;
    e.preventDefault();
    const next = e.key === 'ArrowDown' ? current + 1 : current - 1;
    langLinks[(next + langLinks.length) % langLinks.length]?.focus();
  });
  document.addEventListener('click', (e) => {
    if (langSwitch && e.target instanceof Node && !langSwitch.contains(e.target)) setLangOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (langSwitch?.dataset.open === 'true' && desktop.matches) {
      setLangOpen(false);
      langButton?.focus();
      return;
    }
    if (header?.dataset.menuOpen === 'true') {
      setOpen(false);
      button?.focus();
    }
  });

  // The switcher keeps the current page and its query, and remembers the choice for "/".
  langLinks.forEach((link) => {
    link.addEventListener('click', () => {
      const chosen = link.dataset.lang ?? 'en';
      rememberLanguage(chosen);
      try {
        localStorage.setItem('pipolune:lang', chosen);
      } catch {
        /* private mode — the URL still carries the language */
      }
      if (location.search) link.href = link.pathname + location.search;
    });
  });

  const counts = document.querySelectorAll<HTMLElement>('[data-cart-count]');
  const render = (s: Session) => {
    counts.forEach((count) => {
      count.textContent = String(s.cartCount);
      count.hidden = s.cartCount === 0;
    });
  };
  onSession(render);
  getSession().then(render).catch(() => {});
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    padding-top: env(safe-area-inset-top);
    background: var(--color-milk);
    border-bottom: 1px solid var(--color-line);
  }

  .site-header__backdrop {
    display: none;
  }

  .site-header[data-menu-open='true'] .site-header__backdrop {
    display: block;
    position: fixed;
    inset: 0;
    padding: 0;
    background: rgb(32 61 43 / 0.35);
    border: 0;
    cursor: pointer;
  }

  .site-header__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-areas:
      'menu logo tools'
      'nav nav nav'
      'prefs prefs prefs';
    align-items: center;
    min-height: 64px;
    background: var(--color-milk);
  }

  .site-header[data-menu-open='true'] .site-header__inner {
    max-height: calc(100dvh - 58px - env(safe-area-inset-top) - env(safe-area-inset-bottom));
    overflow: auto;
    overscroll-behavior: contain;
  }

  .site-header__menu-btn {
    grid-area: menu;
  }

  .site-header__logo {
    grid-area: logo;
    justify-self: center;
  }

  .site-header__logo img {
    width: 112px;
  }

  .site-header__tools {
    grid-area: tools;
    display: flex;
    align-items: center;
  }

  .icon-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--control-height);
    height: var(--control-height);
    padding: 0;
    color: var(--color-forest);
    background: none;
    border: 0;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .bag-link__count {
    position: absolute;
    top: 4px;
    right: 2px;
    min-width: 17px;
    height: 17px;
    padding: 0 4px;
    font-family: var(--font-text);
    font-size: 0.6875rem;
    line-height: 17px;
    text-align: center;
    color: var(--color-milk);
    background: var(--color-forest);
    border-radius: 999px;
  }

  .bag-link__count[hidden] {
    display: none;
  }

  .icon-close,
  .site-header[data-menu-open='true'] .icon-open {
    display: none;
  }

  .site-header[data-menu-open='true'] .icon-close {
    display: inline-flex;
  }

  .site-nav,
  .site-header__prefs {
    display: none;
  }

  .site-header[data-menu-open='true'] .site-nav,
  .site-header[data-menu-open='true'] .site-header__prefs {
    display: block;
    background: var(--color-milk);
  }

  .site-nav {
    grid-area: nav;
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-line);
  }

  .site-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav a {
    display: flex;
    align-items: center;
    min-height: var(--control-height);
    font-size: 1.125rem;
    text-decoration: none;
  }

  .site-header__prefs {
    grid-area: prefs;
    padding-bottom: var(--space-4);
  }

  .site-header__pref + .site-header__pref {
    margin-top: var(--space-3);
  }

  .site-header__pref-label {
    margin: 0 0 var(--space-2);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .lang-switch {
    position: relative;
    z-index: 2;
  }

  .lang-switch__toggle {
    display: none;
  }

  .lang-switch__menu {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .lang-switch__menu a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-height);
    padding: 0 var(--space-3);
    font-size: 1rem;
    text-decoration: none;
    color: var(--color-forest);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }

  .lang-switch__menu a[aria-current='page'] {
    color: var(--color-milk);
    background: var(--color-forest);
    border-color: var(--color-forest);
    font-weight: 500;
  }

  .hide-mobile {
    display: none;
  }

  @media (min-width: 400px) {
    .site-header__logo img {
      width: 132px;
    }
  }

  @media (min-width: 900px) {
    .site-header__inner {
      grid-template-columns: auto minmax(0, 1fr) auto auto;
      grid-template-areas: 'logo nav prefs tools';
      gap: var(--space-5);
      min-height: 80px;
      max-height: none;
      overflow: visible;
    }

    .site-header__menu-btn,
    .site-header__backdrop,
    .site-nav__mobile-only,
    .site-header__pref-label {
      display: none;
    }

    .site-header__logo {
      justify-self: start;
    }

    .site-header__logo img {
      width: 168px;
    }

    .site-nav,
    .site-header[data-menu-open='true'] .site-nav,
    .site-header__prefs,
    .site-header[data-menu-open='true'] .site-header__prefs {
      display: flex;
      align-items: center;
      padding: 0;
      border: 0;
      background: transparent;
    }

    .site-header__prefs {
      gap: var(--space-2);
    }

    .site-header__pref + .site-header__pref {
      margin-top: 0;
    }

    .site-nav ul {
      display: flex;
      gap: var(--space-6);
    }

    .site-nav a {
      font-size: 1.0625rem;
    }

    .site-nav a:hover {
      text-decoration: underline;
      text-underline-offset: 6px;
    }

    .lang-switch__toggle {
      display: inline-flex;
      align-items: center;
      gap: 2px;
      height: var(--control-height);
      padding: 0 var(--space-2);
      color: var(--color-forest);
      background: none;
      border: 0;
      border-radius: var(--radius-sm);
      cursor: pointer;
    }

    .lang-switch__chevron {
      display: inline-flex;
      transition: transform 160ms ease;
    }

    .lang-switch[data-open='true'] .lang-switch__chevron {
      transform: rotate(180deg);
    }

    .lang-switch__menu {
      display: none;
      position: absolute;
      top: calc(100% - 4px);
      right: 0;
      flex-direction: column;
      flex-wrap: nowrap;
      gap: 0;
      min-width: 148px;
      padding: var(--space-2) 0;
      background: var(--color-surface);
      border: 1px solid var(--color-line);
      border-radius: var(--radius-sm);
    }

    .lang-switch[data-open='true'] .lang-switch__menu {
      display: flex;
    }

    .lang-switch__menu a {
      min-height: var(--control-height);
      padding: 0 var(--space-4);
      font-size: 1.0625rem;
      background: transparent;
      border: 0;
      border-radius: 0;
    }

    .lang-switch__menu a:hover,
    .lang-switch__menu a[aria-current='page'] {
      color: var(--color-forest);
      background: transparent;
      text-decoration: underline;
      text-underline-offset: 4px;
    }

    .site-header__tools {
      gap: var(--space-1);
    }

    .hide-mobile {
      display: inline-flex;
    }
  }
</style>
