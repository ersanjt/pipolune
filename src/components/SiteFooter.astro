---
import Icon from './Icon.astro';
import { ui, type Locale } from '../i18n/ui';
import { legal, legalSlugs } from '../i18n/legal';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang];
const copy = legal[lang];
const home = `/${lang}/`;
const year = new Date().getFullYear();
const path = Astro.url.pathname;
const current = (href: string, exact = false) => {
  const target = href.replace(/\/$/, '');
  const here = path.replace(/\/$/, '');
  if (exact) return here === target ? 'page' : undefined;
  return here === target || here.startsWith(`${target}/`) ? 'page' : undefined;
};
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <img src="/brand/wordmark.svg" alt="Pipolune" width="723" height="204" loading="lazy" />
      <p><a href="mailto:info@pipolune.com">info@pipolune.com</a></p>
      <p>© {year} Pipolune</p>
      <p class="site-footer__note">{t.previewNote}</p>
    </div>

    <details class="footer-col" data-footer-col open>
      <summary>{t.nav.shop}</summary>
      <ul>
        <li><a href={`${home}shop/`}>{t.nav.shop}</a></li>
        <li><a href={`${home}#seasons`}>{t.nav.seasons}</a></li>
        <li><a href={`${home}#about`}>{t.nav.about}</a></li>
        <li><a href={`${home}account/`}>{t.account}</a></li>
      </ul>
    </details>

    <details class="footer-col" data-footer-col open>
      <summary>{t.footerHelp}</summary>
      <ul>
        <li><a href={`${home}legal/delivery/`}>{copy.documents.delivery.title}</a></li>
        <li><a href={`${home}legal/returns/`}>{copy.documents.returns.title}</a></li>
        <li><a href="mailto:info@pipolune.com">{t.footerContact}</a></li>
      </ul>
    </details>

    <details class="footer-col" data-footer-col open>
      <summary>{t.footerLegal}</summary>
      <ul>
        <li><a href={`${home}legal/`}>{copy.hubTitle}</a></li>
        {legalSlugs.map((slug) => <li><a href={`${home}legal/${slug}/`}>{copy.documents[slug].title}</a></li>)}
      </ul>
    </details>
  </div>
</footer>

<nav class="mobile-tabbar" aria-label={t.shortcuts}>
  <a href={home} aria-current={current(home, true)}>
    <Icon name="home" />
    <span>{t.home}</span>
  </a>
  <a href={`${home}shop/`} aria-current={current(`${home}shop/`)}>
    <Icon name="shop" />
    <span>{t.nav.shop}</span>
  </a>
  <a class="mobile-tabbar__bag" href={`${home}bag/`} aria-current={current(`${home}bag/`)}>
    <Icon name="bag" />
    <span class="mobile-tabbar__count" data-cart-count hidden></span>
    <span>{t.bag}</span>
  </a>
  <a href={`${home}account/`} aria-current={current(`${home}account/`)}>
    <Icon name="account" />
    <span>{t.account}</span>
  </a>
</nav>

<script is:inline>
  (function () {
    var cols = document.querySelectorAll('[data-footer-col]');
    var mq = window.matchMedia('(min-width: 900px)');
    var apply = function () {
      cols.forEach(function (el, i) {
        if (mq.matches || i === 0) el.setAttribute('open', '');
        else el.removeAttribute('open');
      });
    };
    apply();
    mq.addEventListener('change', apply);
  })();
</script>

<style>
  .site-footer {
    border-top: 1px solid var(--color-line);
    margin-top: var(--space-8);
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  .site-footer__grid {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-5) var(--space-4);
  }

  .site-footer__brand {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    padding-bottom: var(--space-3);
    text-align: center;
  }

  .site-footer img {
    width: 120px;
    margin-bottom: var(--space-2);
  }

  .site-footer a {
    color: var(--color-forest);
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }

  .site-footer__note {
    font-size: 0.8125rem;
  }

  .footer-col {
    border-top: 1px solid var(--color-line);
  }

  .footer-col summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 48px;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--color-forest);
    cursor: pointer;
    list-style: none;
  }

  .footer-col summary::-webkit-details-marker {
    display: none;
  }

  .footer-col summary::after {
    content: '';
    width: 8px;
    height: 8px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
  }

  .footer-col[open] summary::after {
    transform: translateY(2px) rotate(225deg);
  }

  .footer-col ul {
    display: grid;
    gap: var(--space-1);
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
  }

  .footer-col a {
    display: flex;
    align-items: center;
    min-height: 36px;
    text-decoration: none;
  }

  .footer-col a:hover {
    text-decoration: underline;
  }

  .mobile-tabbar {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 40;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    min-height: calc(58px + env(safe-area-inset-bottom));
    padding-bottom: env(safe-area-inset-bottom);
    background: var(--color-milk);
    border-top: 1px solid var(--color-line);
  }

  .mobile-tabbar a {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-height: 58px;
    padding: 6px 2px;
    color: var(--color-text-muted);
    font-size: 0.6875rem;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
  }

  .mobile-tabbar a[aria-current='page'] {
    color: var(--color-forest);
    font-weight: 500;
  }

  .mobile-tabbar__count {
    position: absolute;
    top: 6px;
    left: calc(50% + 6px);
    min-width: 17px;
    height: 17px;
    padding: 0 4px;
    font-size: 0.6875rem;
    line-height: 17px;
    color: var(--color-milk);
    background: var(--color-forest);
    border-radius: 999px;
  }

  .mobile-tabbar__count[hidden] {
    display: none;
  }

  :global(html.nav-open),
  :global(html.nav-open body) {
    overflow: hidden;
  }

  :global(body:has(.mobile-tabbar)) {
    padding-bottom: calc(58px + env(safe-area-inset-bottom));
  }

  @media (min-width: 900px) {
    .site-footer__grid {
      grid-template-columns: 1.3fr repeat(3, minmax(0, 1fr));
      gap: var(--space-6);
      align-items: start;
      padding-block: var(--space-7);
    }

    .site-footer__brand {
      justify-items: start;
      text-align: start;
    }

    .footer-col {
      border-top: 0;
    }

    .footer-col summary {
      min-height: 0;
      margin-bottom: var(--space-3);
      pointer-events: none;
    }

    .footer-col summary::after {
      display: none;
    }

    .footer-col a {
      min-height: 32px;
    }

    .mobile-tabbar {
      display: none;
    }

    :global(body:has(.mobile-tabbar)) {
      padding-bottom: 0;
    }
  }

  @media print {
    .mobile-tabbar {
      display: none;
    }
  }
</style>
