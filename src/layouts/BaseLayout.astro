---
import '../styles/global.css';
import displayLatin from '../assets/fonts/pipolune-display-500-latin.woff2?url';
import displayCyrillic from '../assets/fonts/pipolune-display-500-cyrillic.woff2?url';
import textLatin from '../assets/fonts/pipolune-text-400-latin.woff2?url';
import textCyrillic from '../assets/fonts/pipolune-text-400-cyrillic.woff2?url';
import { locales, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  /** Path after the locale prefix, e.g. "" for home. Used for canonical and hreflang alternates. */
  path?: string;
  noindex?: boolean;
  image?: string;
  jsonLd?: Record<string, unknown>[];
}

const { lang, title, description, path = '', noindex = false, image = '/brand/og-image.jpg', jsonLd = [] } = Astro.props;
const site = Astro.site ?? new URL('https://pipolune.com');
const canonical = new URL(`/${lang}/${path}`, site).href;
// Each language preloads only the subsets it renders (EN/TR: latin; RU: cyrillic plus latin for digits and names).
const preload = lang === 'ru' ? [displayCyrillic, textCyrillic, textLatin] : [displayLatin, textLatin];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {preload.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {
      !noindex && (
        <>
          <link rel="canonical" href={canonical} />
          {locales.map((l) => (
            <link rel="alternate" hreflang={l} href={new URL(`/${l}/${path}`, site).href} />
          ))}
          <link rel="alternate" hreflang="x-default" href={path ? new URL(`/en/${path}`, site).href : new URL('/', site).href} />
        </>
      )
    }
    <meta name="theme-color" content="#F7F2E8" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:site_name" content="Pipolune" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={{ en: 'en_US', tr: 'tr_TR', ru: 'ru_RU' }[lang]} />
    {locales.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={{ en: 'en_US', tr: 'tr_TR', ru: 'ru_RU' }[l]} />)}
    <meta property="og:image" content={new URL(image, site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <slot />
  </body>
</html>
